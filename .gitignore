/node_modules
/.pnp
.pnp.*

# 构建产物
/.next/
/out/
/build

# 测试
/coverage
/.eval-cache/

# 环境变量（绝不提交 Key）
.env
.env.*
!.env.example

# 系统
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 编辑器
.vscode/
.idea/

# 本机代理配置、开发工作树和包缓存
/.claude/
/.codex/
/.impeccable/
/.pnpm-store/

# 浏览器验收产物
/test-results/
/playwright-report/

# 本地知识库与运行数据（代码仓库不承载个人资料）
/.weave/
/vault/
/weave-vault/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 内部审计材料保留在本机，公开结果见 docs/validation.md
/docs/audits/
# 账号实时额度证据仅保留在本机；公开评测只披露本任务累计成本。
/docs/evaluation/**/go-readiness.json

# 桌面安装包作为 Release 附件发布
/dist/
